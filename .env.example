# 基本設定
APP_NAME=Local Short Video Generator
STORAGE_DIR=/storage
REDIS_URL=redis://redis:6379/0

# 動画生成エンジン
VIDEO_ENGINE=mock

# TTS エンジン切替
# gtts / edge / stylebertvits2 / qwen3tts
TTS_ENGINE=gtts
TTS_FALLBACK_ENGINE=qwen3tts

# StyleBertVITS2（TTS_ENGINE=stylebertvits2 時）
# 例: python server_fastapi.py --dir model_assets --host 0.0.0.0 --port 5000
STYLEBERTVITS2_URL=http://host.docker.internal:5000
STYLEBERTVITS2_MODEL_ID=0
STYLEBERTVITS2_SPEAKER_ID=0
STYLEBERTVITS2_STYLE=Neutral
STYLEBERTVITS2_STYLE_WEIGHT=1.0
STYLEBERTVITS2_SDP_RATIO=0.2
STYLEBERTVITS2_NOISE=0.6
STYLEBERTVITS2_NOISEW=0.8
STYLEBERTVITS2_LANGUAGE=JP
STYLEBERTVITS2_MAX_CHARS_PER_REQUEST=90
STYLEBERTVITS2_CHUNK_PAUSE_SECONDS=0.06

# Qwen3-TTS（TTS_ENGINE=qwen3tts 時）
# 既存 worker へ直接入れず、別プロセスの HTTP bridge を叩きます。
QWEN3_TTS_URL=http://host.docker.internal:5005
QWEN3_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3_TTS_MODE=voice_clone
QWEN3_TTS_SPEAKER=chikamichi
QWEN3_TTS_LANGUAGE=Japanese
QWEN3_TTS_INSTRUCT=
QWEN3_TTS_TIMEOUT_SECONDS=600
QWEN3_TTS_MAX_CHARS_PER_REQUEST=60
QWEN3_TTS_CHUNK_PAUSE_SECONDS=0.02
QWEN3_TTS_PRONUNCIATION_MAP_PATH=
QWEN3_TTS_COMPRESS_LONG_SILENCE=true
QWEN3_TTS_LONG_SILENCE_DETECT_SECONDS=0.24
QWEN3_TTS_LONG_SILENCE_KEEP_SECONDS=0.12
QWEN3_TTS_TRIM_CHUNK_SILENCE=false
QWEN3_TTS_SILENCE_THRESHOLD_DB=-45dB
QWEN3_TTS_SPEED_GAIN=1.0
QWEN3_TTS_VOLUME_GAIN=2.4

# 出力
DEFAULT_DURATION=60
DEFAULT_WIDTH=1080
DEFAULT_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_SCENES_60=8
DEFAULT_SCENES_30=5
DEFAULT_SCENES_15=3
SCENE_TIMING_CHARS_PER_SECOND=8.5
SCENE_TIMING_PADDING_SECONDS=0.25
AUDIO_MAX_TEMPO_COMPRESSION=1.10
AUDIO_MAX_TAIL_PAD_SECONDS=0.80
AUDIO_MIN_SCENE_DURATION=2.60
SUBTITLE_READ_CHARS_PER_SECOND=8.0

# 字幕
SUBTITLE_FONT=Noto Serif CJK JP
SUBTITLE_FONT_SIZE=72
SUBTITLE_MARGIN_V=105
SUBTITLE_PRIMARY_COLOR=&H00E6EFF4&
SUBTITLE_OUTLINE_COLOR=&H0014171A&

# BGMは任意。storage/assets/bgm.mp3 があれば利用。
BGM_VOLUME=0.12

# 字幕設定
SUBTITLE_WRAP_CHARS=14
SUBTITLE_MAX_LINES=3
SUBTITLE_POSITION_FROM_BOTTOM_PCT=33

# Luma / Dream Machine (VIDEO_ENGINE=luma or UI selection)
LUMAAI_API_KEY=
LUMA_MODEL=ray-flash-2
LUMA_DURATION=5s
LUMA_RESOLUTION=720p
LUMA_API_BASE=https://api.lumalabs.ai/dream-machine/v1
LUMA_POLL_SECONDS=5
LUMA_TIMEOUT_SECONDS=300

# Google Veo 3.1 Lite (VIDEO_ENGINE=veo_lite or UI selection)
# 1) Google AI Studio で API key を作成
# 2) Gemini API の有料ティア/課金を有効化
# 3) 必要なら Google Cloud 側で Generative Language API を有効化
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-lite-generate-preview
VEO_DURATION_SECONDS=6
VEO_RESOLUTION=720p
VEO_API_BASE=https://generativelanguage.googleapis.com/v1beta
VEO_POLL_SECONDS=10
VEO_TIMEOUT_SECONDS=900

# AnalystK high precision lip-sync service
LIPSYNC_ENABLED=false
LIPSYNC_URL=http://lipsync:7860
LIPSYNC_ENDPOINT=/generate
LIPSYNC_TIMEOUT_SECONDS=1800
LIPSYNC_ANALYSTK_SOURCE=
LIPSYNC_ANALYSTK_SOURCE_MODE=image
LIPSYNC_ANALYSTK_SOURCE_SET=anime
LIPSYNC_ANALYSTK_DISPLAY_MODE=bottom
LIPSYNC_ANALYSTK_IMAGE_SOURCE=
LIPSYNC_ANALYSTK_VIDEO_SOURCE=
LIPSYNC_ANALYSTK_ANIME_IMAGE_SOURCE=
LIPSYNC_ANALYSTK_ANIME_VIDEO_SOURCE=
LIPSYNC_ANALYSTK_REAL_IMAGE_SOURCE=
LIPSYNC_ANALYSTK_REAL_VIDEO_SOURCE=
LIPSYNC_PROVIDER=wav2lip
LIPSYNC_COMMAND_TEMPLATE=
WAV2LIP_DIR=/models/Wav2Lip
WAV2LIP_CHECKPOINT=/models/Wav2Lip/checkpoints/wav2lip_gan.pth
WAV2LIP_FACE_DET_BATCH_SIZE=4
WAV2LIP_BATCH_SIZE=16
LIPSYNC_OVERLAY_WIDTH_RATIO=0.94
LIPSYNC_OVERLAY_BOTTOM_MARGIN_RATIO=0.035
ANALYSTK_DENOISE=true
ANALYSTK_DENOISE_NOISE_FLOOR=-28
ANALYSTK_LOW_PASS_FREQUENCY=9200
